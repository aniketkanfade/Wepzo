{
  "expo": {
    "name": "Wepzo Admin",
    "slug": "wepzo-admin-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Wepzo Admin to select product images."
        }
      ]
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.wepzo.admin"
    }
  }
}
