# API host for the E-Commerce module; defaults to http://localhost:5000/api
VITE_E_COMMERCE_API_URL=http://localhost:5000/api

# Optional fixed tenant context for this storefront
VITE_WEBSITE_ID=
VITE_WEBSITE_MODULE_ID=

# Optional Vite dev proxy target, for example http://localhost:5000
VITE_API_PROXY_TARGET=
