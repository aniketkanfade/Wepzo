# Use a unique random value with at least 32 characters. Keep it stable across restarts;
# changing it makes previously saved payment gateway credentials unreadable.
PAYMENT_CREDENTIALS_ENCRYPTION_KEY=

# Required in production; local file persistence is only a development fallback.
MONGODB_URI=

# Optional. Marketing social connect also reads app credentials from Admin → Marketing → Social APIs.
BACKEND_PUBLIC_URL=
MARKETING_FRONTEND_URL=
SOCIAL_TOKEN_ENCRYPTION_KEY=
META_CLIENT_ID=
META_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
